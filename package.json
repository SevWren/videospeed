{
  "name": "video-speed-controller",
  "version": "0.9.1",
  "description": "Speed up, slow down, advance and rewind HTML5 audio/video and animated GIFs with shortcuts",
  "type": "module",
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:unit": "node tests/run-tests.js unit",
    "test:integration": "node tests/run-tests.js integration",
    "test:e2e": "node tests/e2e/run-e2e.js",
    "test:gif": "node tests/run-tests.js gif",
    "test:browser": "echo 'Open tests/fixtures/test-page.html in browser'",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "format": "prettier --write src/**/*.js tests/**/*.js",
    "build": "npm run lint:fix && npm run format && npm run test",
    "zip": "rm -rf dist && mkdir -p dist/videospeed && cp -r manifest.json src *.md dist/videospeed/ && cd dist && zip -r videospeed.zip videospeed && cd .. && echo 'Extension packaged at dist/videospeed.zip'",
    "check:lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "check:format": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "check:structure": "node scripts/check-structure.mjs",
    "check:seams": "node scripts/check-seams.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:citations": "node scripts/verify-citations.mjs",
    "map:repo": "node scripts/gen-repo-map.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "eslint": "^8.57.1",
    "globals": "^13.24.0",
    "jsdom": "^23.2.0",
    "prettier": "^3.1.0",
    "puppeteer": "^24.10.2"
  },
  "eslintConfig": {
    "ignorePatterns": [
      "src/lib/*.min.js"
    ],
    "env": {
      "browser": true,
      "es2022": true,
      "node": true,
      "webextensions": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "globals": {
      "chrome": "readonly"
    },
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "no-console": "off",
      "prefer-const": "error",
      "no-var": "error",
      "eqeqeq": "error",
      "curly": "error",
      "semi": [
        "error",
        "always"
      ],
      "quotes": [
        "error",
        "single",
        {
          "avoidEscape": true
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "dependencies": {
    "gifuct-js": "^2.1.2"
  }
}
